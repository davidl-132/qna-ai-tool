# Copy file này thành .env rồi điền key thật. KHÔNG đưa .env lên GitHub.

# Nhà cung cấp chính và dự phòng: gemini | groq | grok | mock (mock = trả lời giả để test)
PROVIDER=gemini
FALLBACK_PROVIDER=groq

GEMINI_API_KEY=
# Chạy `python -m scripts.list_models` để xem tên model key của bạn dùng được
GEMINI_MODEL=gemini-2.5-flash
# Model dự phòng khi model chính báo 503 "high demand" (cách nhau bằng dấu phẩy)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
# Số lần tự thử lại cho mỗi model khi gặp lỗi tạm thời
GEMINI_RETRIES=2

# Groq (groq.com, key bắt đầu bằng gsk_) - có gói miễn phí
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Grok của xAI (khác Groq) - chỉ điền nếu bạn có key xAI
XAI_API_KEY=
# Xem tên model trong console.x.ai
XAI_MODEL=grok-4.3

# Giới hạn độ dài (ký tự)
MAX_SELECTION_CHARS=4000
MAX_CONTEXT_CHARS=1500

DEFAULT_LANG=vi

# Server cục bộ (chỉ chạy trên 127.0.0.1)
PORT=8765
# Để trống: lần chạy đầu server sẽ tự tạo token và ghi vào đây.
# Dán token này vào trang Options của extension.
LOCAL_TOKEN=
