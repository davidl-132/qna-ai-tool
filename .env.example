# Copy file này thành .env rồi điền key thật. KHÔNG đưa .env lên GitHub.

# Nhà cung cấp chính và dự phòng: gemini | grok | mock (mock = trả lời giả để test)
PROVIDER=gemini
FALLBACK_PROVIDER=grok

GEMINI_API_KEY=
# Chạy `python -m scripts.list_models` để xem tên model key của bạn dùng được
GEMINI_MODEL=gemini-2.5-flash

XAI_API_KEY=
# Xem tên model trong console.x.ai
XAI_MODEL=grok-4.3

# Giới hạn độ dài (ký tự)
MAX_SELECTION_CHARS=4000
MAX_CONTEXT_CHARS=1500

DEFAULT_LANG=vi
